{
  "name": "@skilldeck/cli",
  "version": "0.2.0",
  "description": "Command-line interface for SkillDeck — scan, lint, budget, conflicts, route, immune, hub (MCP stdio gateway), SuperAgent runner, export, and serve.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "skilldeck": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@skilldeck/core": "workspace:*",
    "@skilldeck/hub": "workspace:*",
    "@skilldeck/server": "workspace:*"
  }
}
